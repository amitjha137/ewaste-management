MONGODB_URI=mongodb://localhost:27017/ewaste
JWT_SECRET=your_jwt_secret
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password
TWILIO_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE=your_twilio_phone_number

# Comma-separated device tokens for IoT devices. If empty, devices may register without a token.
# Example: DEVICE_TOKENS=raspi-secret-token,another-token
DEVICE_TOKENS=

# --- Sorter (laptop + ESP32) ---
# Token(s) the sorter must send when it registers. Use the same value in sorter/run.bat (--token).
# DEVICE_TOKENS=my-sorter-token

# Model service used by the dashboard "Run Model" / browser-camera buttons (FastAPI in backend/model_service)
MODEL_SERVICE_URL=http://localhost:8001

# Which bin (its _id from the Bins list) the sorter should add items to. Optional.
# SORTER_BIN_ID=
# There is no fill sensor: bin level is estimated from the number of sorted items.
ITEMS_PER_BIN_FULL=50
DEFAULT_ITEM_WEIGHT_KG=0.2

# Admin token for /api/device-mgmt
# ADMIN_TOKEN=
PORT=5000

# Fill level from the ToF sensor: status becomes "full" at FULL_LEVEL and clears below FULL_LEVEL_CLEAR (percent)
FULL_LEVEL=85
FULL_LEVEL_CLEAR=70
